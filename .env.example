# PostgreSQL Connection
DATABASE_URL=postgresql://user:password@localhost:5432/negative_memory
PGHOST=localhost
PGPORT=5432
PGDATABASE=negative_memory
PGUSER=user
PGPASSWORD=password

# Anthropic API Key (required for Judge reasoning and embedding fallback)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model Configuration
JUDGE_MODEL=claude-sonnet-4-5-20250929
EMBEDDING_MODEL=claude-sonnet-4-5-20250929

# Search Configuration
MAX_SEARCH_RESULTS=10
SIMILARITY_THRESHOLD=0.3
